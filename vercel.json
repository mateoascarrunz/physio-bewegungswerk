{
  "rewrites": [
    {
      "source": "/kontakt",
      "destination": "/kontakt/index.html"
    },
    {
      "source": "/behandlungstechniken",
      "destination": "/behandlungstechniken/index.html"
    },
    {
      "source": "/behandlungstechniken/:serviceid",
      "destination": "/behandlungstechniken/:serviceid/index.html"
    },
    {
      "source": "/uberuns",
      "destination": "/uberuns/index.html"
    },
    {
      "source": "/news",
      "destination": "/news/index.html"
    },
    {
      "source": "/news/:article",
      "destination": "/news/:article/index.html"
    },
    {
      "source": "/private",
      "destination": "/private/index.html"
    },
    {
      "source": "/faq",
      "destination": "/faq/index.html"
    },
    {
      "source": "/datenschutz",
      "destination": "/datenschutz/index.html"
    },
    {
      "source": "/impressum",
      "destination": "/impressum/index.html"
    },
    {
      "source": "/admin",
      "destination": "/shell.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-SshHVWyee8ucP0gsl9RL6dPynFV30enJxhPJhPzh+6E='; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://res.cloudinary.com; font-src 'self'; connect-src 'self' https://api.emailjs.com; frame-src https://www.google.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
