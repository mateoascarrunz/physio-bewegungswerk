{
  "name": "physio-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/fetch-cms-content.mjs",
    "build": "npm run build:site",
    "preview": "node scripts/serve.mjs",
    "lint": "eslint .",
    "test:unit": "vitest run --dir tests/unit",
    "test:e2e": "playwright test",
    "build:site": "vite build --ssrManifest && vite build --ssr src/entry-server.js --outDir dist-ssr && node scripts/prerender.mjs"
  },
  "engines": {
    "node": "22.x",
    "npm": ">=10"
  },
  "dependencies": {
    "@emailjs/browser": "^5.0.3",
    "@fontsource-variable/montserrat": "^5.3.0",
    "lottie-web": "^5.13.0",
    "markdown-it": "^15.0.3",
    "vue": "^3.5.45",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
